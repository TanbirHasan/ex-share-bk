# Copy to .env and fill in. The server validates these on boot and refuses to start if any are missing/invalid.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/experiencehub

# Shared HS256 secret used to verify JWTs minted by the Next.js frontend (Auth.js).
# Must be identical on both sides. Generate: openssl rand -base64 48
AUTH_SHARED_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Secret for server-to-server /internal routes (frontend -> backend user sync).
# Generate: openssl rand -base64 24
INTERNAL_API_SECRET=change-me-internal-secret

# Comma-separated list of allowed browser origins for CORS
CORS_ORIGIN=http://localhost:3000

LOG_LEVEL=info

# Uploaded product images: where they're stored on disk (relative to the backend
# folder unless absolute) and the base URL they're served from. In production set
# PUBLIC_BASE_URL to the API's public origin so image URLs resolve for browsers.
# UPLOAD_DIR=uploads
# PUBLIC_BASE_URL=http://localhost:4000
# MAX_UPLOAD_BYTES=6291456

# Optional: LibreTranslate-compatible endpoint for the on-demand "Translate" button
# on reviews / problems / solutions. Leave unset to disable the feature (the API
# then returns 503 and the UI shows "Translation isn't set up on this server yet").
# Self-host: docker run -p 5000:5000 libretranslate/libretranslate  ->  http://localhost:5000
# TRANSLATE_ENDPOINT=http://localhost:5000
# TRANSLATE_API_KEY=
